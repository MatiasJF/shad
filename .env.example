# Shad Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Redis Configuration (required)
# =============================================================================
# For local development
# REDIS_URL=redis://localhost:6379/0
# For Docker (use this when running via docker-compose)
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Obsidian Vault Configuration
# =============================================================================
# Path to your Obsidian vault (absolute path)
# For Docker: Use the host path, it will be mounted in the container
OBSIDIAN_VAULT_PATH=/path/to/your/vault

# Optional: Obsidian Local REST API
# Install: https://github.com/coddingtonbear/obsidian-local-rest-api
OBSIDIAN_API_KEY=
OBSIDIAN_BASE_URL=https://127.0.0.1:27124
OBSIDIAN_VERIFY_SSL=false

# =============================================================================
# LLM Provider API Keys (required - at least one)
# =============================================================================
# Anthropic Claude API (recommended)
ANTHROPIC_API_KEY=

# OpenAI API (alternative/fallback)
OPENAI_API_KEY=

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
DEBUG=false

# =============================================================================
# Budget Defaults (optional)
# =============================================================================
DEFAULT_MAX_DEPTH=3
DEFAULT_MAX_NODES=50
DEFAULT_MAX_WALL_TIME=300
DEFAULT_MAX_TOKENS=100000

# =============================================================================
# Path Configuration (optional - for local development)
# =============================================================================
HISTORY_PATH=./History
SKILLS_PATH=./Skills
CORE_PATH=./CORE
